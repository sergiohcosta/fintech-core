# URL de conexão do banco de dados na Neon.tech
# Formato: postgresql://[user]:[password]@[host]/[dbname]?sslmode=require
DATABASE_URL_NEON=your_neon_connection_string_here

# URL PÚBLICA do Postgres no Railway (Railway → Postgres → Variables → DATABASE_PUBLIC_URL)
# Usada por sync-tenant.sh. Formato libpq (NÃO jdbc):
# postgresql://postgres:[password]@[host].proxy.rlwy.net:[porta]/railway
DATABASE_URL_RAILWAY=your_railway_public_url_here

# (opcional) sobrescreve a URL do banco local usada por sync-tenant.sh
# DATABASE_URL_LOCAL=postgresql://admin:secret@localhost:5432/fintech

# Tenant-alvo do sync-tenant.sh (UUID). Obrigatório para rodar o sync.
SYNC_TENANT_ID=your_tenant_uuid_here
