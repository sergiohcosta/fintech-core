{
  "mcpServers": {
    "postgres": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres", "postgresql://admin:secret@localhost:5432/fintech"]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-code-edit-on-develop.py\"",
            "timeout": 10,
            "statusMessage": "Verificando branch antes de editar código"
          }
        ]
      }
    ]
  }
}
